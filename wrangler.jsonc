{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yearn-docs",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "build",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "docs.yearn.fi/*", "zone_name": "yearn.fi" }],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": []
    }
  }
}
